{
    "name": "pressing_manager/pressing-system",
    "description": "Système de gestion de pressing professionnel",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Équipe Pressing Manager",
            "email": "contact@pressing-manager.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "phpmailer/phpmailer": "^6.5",
        "tecnickcom/tcpdf": "^6.4",
        "phpoffice/phpspreadsheet": "^1.23",
        "endroid/qr-code": "^4.0",
        "picqer/php-barcode-generator": "^2.0",
        "respect/validation": "^2.0",
        "monolog/monolog": "^2.0",
        "symfony/cache": "^5.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "mockery/mockery": "^1.0",
        "fakerphp/faker": "^1.0",
        "squizlabs/php_codesniffer": "^3.0",
        "phpmd/phpmd": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Controllers\\": "controllers/",
            "Models\\": "models/"
        },
        "files": [
            "app/Helpers/functions.php",
            "config/constants.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"if (file_exists('config/.env.example')) copy('config/.env.example', 'config/.env');\"",
            "php -r \"if (!is_dir('logs')) mkdir('logs', 0777, true);\"",
            "php -r \"if (!is_dir('temp')) mkdir('temp', 0777, true);\""
        ],
        "test": "phpunit",
        "migrate": "php migrations/migrate.php"
    },
    "config": {
        "sort-packages": true,
        "platform-check": false,
        "process-timeout": 600
    }
}